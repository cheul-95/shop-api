# cp .env.example .env 후 값을 채운다 (.env는 git에 올리지 않음)

# HS256 서명 키. Base64 문자열, 디코딩 후 32바이트(256bit) 이상
# 생성: openssl rand -base64 48
JWT_SECRET=

# ---- 아래는 서버 배포(docker-compose.prod.yml)에서만 사용 ----
# 생성: openssl rand -base64 24
# MYSQL_ROOT_PASSWORD=
# DB_PASSWORD=
# 첫 배포 1회만: 테이블 생성 + 샘플 데이터
# DDL_AUTO=update
# SQL_INIT_MODE=always
